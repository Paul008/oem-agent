{
  // Multi-OEM AI Agent — OpenClaw on Moltworker
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/

  "name": "oem-agent",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-02-11",
  "compatibility_flags": ["nodejs_compat"],

  // R2 Storage (agent memory + OEM assets)
  "r2_buckets": [
    {
      "binding": "MOLTBOT_BUCKET",
      "bucket_name": "oem-agent-assets"
    },
    {
      "binding": "OEM_PAGE_BUCKET",
      "bucket_name": "oem-agent-assets"
    }
  ],

  // Browser Rendering (headless Chromium via CDP)
  "browser": {
    "binding": "BROWSER"
  },

  // AI Gateway (observability proxy)
  "ai": {
    "binding": "AI"
  },

  // Vectorize (UX knowledge base for semantic retrieval)
  "vectorize": [
    {
      "binding": "UX_KNOWLEDGE",
      "index_name": "ux-knowledge-base"
    }
  ],

  // Cloudflare Workflows (durable multi-step orchestration)
  "workflows": [
    {
      "name": "brochure-mirror",
      "binding": "BROCHURE_MIRROR",
      "class_name": "BrochureMirrorWorkflow"
    }
  ],

  // Cloudflare Containers (Sandbox for code execution)
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10
    }
  ],

  // Cloudflare Sandbox (Durable Object binding)
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "McpSession",
        "class_name": "McpSession"
      }
    ]
  },

  // Migrations for Durable Objects with Containers (requires new_sqlite_classes)
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["McpSession"]
    }
  ],

  // Environment Variables
  "vars": {
    "ENVIRONMENT": "production",
    "SANDBOX_SLEEP_AFTER": "never",
    "DEV_MODE": "false",
    "NISSAN_STAGED_WRITES_ENABLED": "false",
    "NISSAN_CATALOG_PROMOTION_ENABLED": "false",
    "NISSAN_CATALOG_ROLLBACK_ENABLED": "false",
    "NISSAN_OFFER_STAGING_ENABLED": "false",
    "NISSAN_OFFER_PROMOTION_ENABLED": "false",
    "NISSAN_OFFER_ROLLBACK_ENABLED": "false",
    "OPENCLAW_DEV_MODE": "false",
    "MODEL_PAGE_PUBLICATION_ENABLED_PAGE_IDS": "",
    "MODEL_PAGE_WEBHOOK_ALLOWED_ORIGINS": "",
    "R2_BUCKET_NAME": "oem-agent-assets",
    "CF_ACCOUNT_ID": "a5b299b3ad15c1b5b895dc66f9357b17",
    // Optional: public hostname for dealer/inventory media URLs.
    // Set to a dedicated custom domain, e.g. "https://media.your-oem-domain.com".
    "MEDIA_BASE_URL": "https://oemmedia.driveagent.io",
    // Optional: Lightpanda WebSocket URL for headless browser rendering.
    // When not set, falls back to Cloudflare Browser (env.BROWSER binding).
    "LIGHTPANDA_URL": "",
    // Apify actor that fetches bot-blocked brochure PDFs off-Cloudflare
    // (residential proxy) for the brochure-mirror Workflow.
    "APIFY_PDF_FETCH_ACTOR_ID": "J2BGYKGzL18sNxusx"
  },

  "routes": [
    {
      "pattern": "oemmedia.driveagent.io",
      "custom_domain": true
    }
  ],

  // Secrets (set via `wrangler secret put`):
  // SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD
  // GROQ_API_KEY, TOGETHER_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, PERPLEXITY_API_KEY
  // RESEND_API_KEY
  // SLACK_WEBHOOK_URL, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET
  // BRAVE_SEARCH_API_KEY
  // CLOUDFLARE_ACCOUNT_ID
  // APIFY_TOKEN (for actor-based scraping — Toyota, etc.)
  // CDP_SECRET
  // MCP_AUTH_TOKEN (optional dedicated bearer token for MCP clients)
  // MODEL_PAGE_WEBHOOK_SECRET (shared with the registered dealer webhook receiver)

  // Cron Triggers (crawl schedules)
  // Cron Triggers — times in UTC (AEST = UTC + 11 during AEDT / UTC + 10 during AEST)
  // 17:00 UTC = 4am AEDT, 18:00 UTC = 5am AEDT, etc.
  "triggers": {
    "crons": [
      "0 17 * * *",
      "30 17 * * *",
      "0 18 * * *",
      "0 6,18 * * *",
      "0 19 * * *",
      "30 18 * * *",
      "0 16 1 * *",
      "0 3 * * *",
      "30 16 * * *",
      "45 16 * * *"
    ]
  },

  // Dev environment
  "env": {
    "dev": {
      "name": "oem-agent-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "SANDBOX_SLEEP_AFTER": "never",
        "DEV_MODE": "true",
        "NISSAN_STAGED_WRITES_ENABLED": "false",
        "NISSAN_CATALOG_PROMOTION_ENABLED": "false",
        "NISSAN_CATALOG_ROLLBACK_ENABLED": "false",
        "NISSAN_OFFER_STAGING_ENABLED": "false",
        "NISSAN_OFFER_PROMOTION_ENABLED": "false",
        "NISSAN_OFFER_ROLLBACK_ENABLED": "false",
        "OPENCLAW_DEV_MODE": "true",
        "MODEL_PAGE_PUBLICATION_ENABLED_PAGE_IDS": "nissan-au-ariya",
        "MODEL_PAGE_WEBHOOK_ALLOWED_ORIGINS": "",
        "R2_BUCKET_NAME": "oem-agent-assets-dev",
        "CF_ACCOUNT_ID": "a5b299b3ad15c1b5b895dc66f9357b17",
        "MEDIA_BASE_URL": "",
        // Optional: Lightpanda WebSocket URL (falls back to Cloudflare Browser)
        "LIGHTPANDA_URL": ""
      },
      "r2_buckets": [
        {
          "binding": "MOLTBOT_BUCKET",
          "bucket_name": "oem-agent-assets-dev"
        },
        {
          "binding": "OEM_PAGE_BUCKET",
          "bucket_name": "oem-agent-assets-dev"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "ai": {
        "binding": "AI"
      },
      "vectorize": [
        {
          "binding": "UX_KNOWLEDGE",
          "index_name": "ux-knowledge-base"
        }
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 10
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Sandbox",
            "class_name": "Sandbox"
          },
          {
            "name": "McpSession",
            "class_name": "McpSession"
          }
        ]
      }
    }
  }
}
