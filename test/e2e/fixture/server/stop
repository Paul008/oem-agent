#!/bin/bash
# Stop and clean up ALL cloud e2e infrastructure
#
# This script:
# 1. Deletes the deployed worker
# 2. Deletes the R2 bucket (may fail if not empty - requires manual cleanup)
# 3. Deletes the service token
# 4. Cleans up local state files
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Find E2E_DIR for .dev.vars
if [ -n "$CCTR_TEST_PATH" ]; then
    E2E_DIR="$CCTR_TEST_PATH"
else
    FIXTURE_DIR="$(dirname "$SCRIPT_DIR")"
    E2E_DIR="$(dirname "$FIXTURE_DIR")"
fi

# Source .dev.vars if it exists
if [ -f "$E2E_DIR/.dev.vars" ]; then
    set -a
    source "$E2E_DIR/.dev.vars"
    set +a
fi

# Export CLOUDFLARE_ACCOUNT_ID (wrangler prefers this over CF_ACCOUNT_ID)
export CLOUDFLARE_ACCOUNT_ID="${CF_ACCOUNT_ID:-}"

# Support running directly (not via cctr)
if [ -z "$CCTR_FIXTURE_DIR" ]; then
    CCTR_FIXTURE_DIR="/tmp/e2e-cloud-manual"
fi

echo "Stopping cloud e2e infrastructure..." >&2
CLEANUP_FAILED=false
WORKER_ABSENT=false

# Read saved values from fixture dir
WORKER_NAME=$(cat "$CCTR_FIXTURE_DIR/worker-name.txt" 2>/dev/null || echo "")
R2_BUCKET=$(cat "$CCTR_FIXTURE_DIR/r2-bucket-name.txt" 2>/dev/null || echo "")
TEST_RUN_ID=$(cat "$CCTR_FIXTURE_DIR/test-run-id.txt" 2>/dev/null || echo "")
ACCESS_APP_ID=$(cat "$CCTR_FIXTURE_DIR/access-app-id.txt" 2>/dev/null || echo "")
WORKER_URL=$(cat "$CCTR_FIXTURE_DIR/worker-url.txt" 2>/dev/null || echo "")

# Empty the prefix-guarded ephemeral bucket through its binding before deleting
# the Worker. This also removes any OpenClaw data written during the smoke test.
if [ -n "$WORKER_URL" ] && [ -n "$ACCESS_APP_ID" ]; then
    echo "Emptying E2E R2 bucket through the protected Worker..." >&2
    "$SCRIPT_DIR/../curl-auth" -sf -X DELETE "$WORKER_URL/debug/e2e-storage" >/dev/null 2>&1 || \
        echo "Warning: Failed to empty E2E R2 bucket through Worker." >&2
fi

# Step 0: Delete the deployed worker while Access still protects its hostname.
if [ -n "$WORKER_NAME" ]; then
    echo "Deleting worker: $WORKER_NAME" >&2
    if "$SCRIPT_DIR/delete-worker" "$WORKER_NAME" 2>&1; then
        WORKER_ABSENT=true
    else
        CLEANUP_FAILED=true
        echo "ERROR: Worker deletion was not verified; retaining Access protection." >&2
    fi
else
    if [ -n "$ACCESS_APP_ID" ]; then
        CLEANUP_FAILED=true
        echo "ERROR: Worker identity is missing; retaining Access because absence cannot be verified." >&2
    else
        WORKER_ABSENT=true
    fi
fi

# Step 0b: Delete the container application
CONTAINER_NAME=$(cat "$CCTR_FIXTURE_DIR/container-name.txt" 2>/dev/null || echo "${WORKER_NAME}-sandbox")
if [ -n "$WORKER_NAME" ] && [ -n "$CLOUDFLARE_API_TOKEN" ] && [ -n "$CLOUDFLARE_ACCOUNT_ID" ]; then
    echo "Deleting container: $CONTAINER_NAME" >&2
    CONTAINERS_RESPONSE=$(curl -s -X GET \
        "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/containers/applications" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" || echo '{"success":false}')
    if ! echo "$CONTAINERS_RESPONSE" | jq -e '.success == true' >/dev/null 2>&1; then
        CLEANUP_FAILED=true
        echo "ERROR: Could not list container applications." >&2
    else
        CONTAINER_ID=$(echo "$CONTAINERS_RESPONSE" | jq -r ".result[] | select(.name == \"$CONTAINER_NAME\") | .id" 2>/dev/null || echo "")
    fi

    if [ -n "${CONTAINER_ID:-}" ]; then
        CONTAINER_RESPONSE=$(curl -s -X DELETE \
            "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/containers/applications/$CONTAINER_ID" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" || echo '{"success":false}')
        if echo "$CONTAINER_RESPONSE" | jq -e '.success == true' >/dev/null 2>&1; then
            echo "Container deleted" >&2
        else
            CLEANUP_FAILED=true
            echo "ERROR: Container deletion failed: $CONTAINER_NAME" >&2
        fi
    fi
fi

# Step 1: Delete Access only after the public Worker endpoint is gone.
if [ "$WORKER_ABSENT" = true ] && [ -n "$ACCESS_APP_ID" ] && [ -n "$CLOUDFLARE_API_TOKEN" ] && [ -n "$CLOUDFLARE_ACCOUNT_ID" ]; then
    echo "Deleting Access application: $ACCESS_APP_ID" >&2
    ACCESS_RESPONSE=$(curl -s -X DELETE \
        "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/access/apps/$ACCESS_APP_ID" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" || echo '{"success":false}')
    if echo "$ACCESS_RESPONSE" | jq -e '.success == true' >/dev/null 2>&1; then
        echo "Access application deleted" >&2
    else
        CLEANUP_FAILED=true
        echo "ERROR: Access application deletion failed: $ACCESS_APP_ID" >&2
    fi
elif [ "$WORKER_ABSENT" != true ] && [ -n "$ACCESS_APP_ID" ]; then
    echo "Access application retained to protect the surviving Worker." >&2
fi

# Step 2: Delete R2 bucket
# The protected cleanup route empties the binding first; retain the warning as a
# fail-safe if cleanup could not run.
if [ -n "$R2_BUCKET" ]; then
    echo "Deleting R2 bucket: $R2_BUCKET" >&2
    if ! npx wrangler r2 bucket delete "$R2_BUCKET" 2>&1; then
        CLEANUP_FAILED=true
        echo "ERROR: Failed to delete R2 bucket. Manual cleanup required: $R2_BUCKET" >&2
    fi
fi

# Step 3: Delete service token via API
if [ -n "$TEST_RUN_ID" ] && [ -n "$CLOUDFLARE_API_TOKEN" ] && [ -n "$CLOUDFLARE_ACCOUNT_ID" ]; then
    echo "Deleting service token: moltbot-e2e-$TEST_RUN_ID" >&2
    TOKENS_RESPONSE=$(curl -s -X GET \
        "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/access/service_tokens" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" || echo '{"success":false}')
    if ! echo "$TOKENS_RESPONSE" | jq -e '.success == true' >/dev/null 2>&1; then
        CLEANUP_FAILED=true
        echo "ERROR: Could not list E2E service tokens." >&2
    else
        TOKEN_ID=$(echo "$TOKENS_RESPONSE" | jq -r ".result[] | select(.name == \"moltbot-e2e-$TEST_RUN_ID\") | .id" 2>/dev/null || echo "")
    fi

    if [ -n "${TOKEN_ID:-}" ]; then
        TOKEN_RESPONSE=$(curl -s -X DELETE \
            "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/access/service_tokens/$TOKEN_ID" \
            -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
            -H "Content-Type: application/json" || echo '{"success":false}')
        if echo "$TOKEN_RESPONSE" | jq -e '.success == true' >/dev/null 2>&1; then
            echo "Service token deleted" >&2
        else
            CLEANUP_FAILED=true
            echo "ERROR: Service token deletion failed: $TOKEN_ID" >&2
        fi
    fi
fi

# Step 4: Clean up local files
if [ "$CLEANUP_FAILED" = true ]; then
    echo "Cloud E2E cleanup incomplete; state files retained in $CCTR_FIXTURE_DIR and $SCRIPT_DIR." >&2
    exit 1
fi

echo "Cleaning up local files..." >&2
rm -f "$CCTR_FIXTURE_DIR/terraform-output.json"
rm -f "$CCTR_FIXTURE_DIR/worker-url.txt"
rm -f "$CCTR_FIXTURE_DIR/worker-name.txt"
rm -f "$CCTR_FIXTURE_DIR/gateway-token.txt"
rm -f "$CCTR_FIXTURE_DIR/cf-access-client-id.txt"
rm -f "$CCTR_FIXTURE_DIR/cf-access-client-secret.txt"
rm -f "$CCTR_FIXTURE_DIR/test-run-id.txt"
rm -f "$CCTR_FIXTURE_DIR/r2-bucket-name.txt"
rm -f "$CCTR_FIXTURE_DIR/container-name.txt"
rm -f "$CCTR_FIXTURE_DIR/access-app-id.txt"
rm -f "$CCTR_FIXTURE_DIR/access-aud.txt"
rm -rf "$SCRIPT_DIR/.terraform" "$SCRIPT_DIR/terraform.tfstate"* "$SCRIPT_DIR/.terraform.lock.hcl"

echo "Cloud e2e infrastructure stopped and cleaned up" >&2
sleep 1  # Let stderr flush before stdout
echo "stopped"
